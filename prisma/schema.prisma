generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CiCdProvider {
  GITHUB
  GITLAB
  BITBUCKET
  OTHER
}

enum MonitoringProvider {
  PROMETHEUS
  DATADOG
  GRAFANA
  CLOUDWATCH
  OTHER
}

enum ResourceStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SubscriptionPlan {
  MONITORING
  CICD
  FULL
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

model Organization {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       Membership[]
  ciCdIntegrations  CiCdIntegration[]
  monitoringSources MonitoringSource[]
  alerts            Alert[]
  analysisResults   AnalysisResult[]
  stripeCustomerId  String?            @unique
  subscriptions     Subscription[]

  @@unique([id, slug])
  @@map("organizations")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  sessions        Session[]

  @@map("users")
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole   @default(MEMBER)
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuthAttemptLimit {
  keyHash         String   @id
  attempts        Int
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
  @@map("auth_attempt_limits")
}

model CiCdIntegration {
  id             String         @id @default(cuid())
  organizationId String
  provider       CiCdProvider
  name           String
  repositoryUrl  String
  externalId     String?
  status         ResourceStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, provider, repositoryUrl])
  @@index([organizationId, status])
  @@map("cicd_integrations")
}

model MonitoringSource {
  id                String                       @id @default(cuid())
  organizationId    String
  provider          MonitoringProvider
  name              String
  endpoint          String?
  status            ResourceStatus               @default(ACTIVE)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alerts            Alert[]
  webhookCredential MonitoringWebhookCredential?

  @@unique([organizationId, id])
  @@unique([organizationId, provider, name])
  @@index([organizationId, status])
  @@map("monitoring_sources")
}

model Alert {
  id              String            @id @default(cuid())
  organizationId  String
  sourceId        String?
  title           String
  description     String?
  severity        AlertSeverity
  status          AlertStatus       @default(OPEN)
  openedAt        DateTime          @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  externalId      String?
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source          MonitoringSource? @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Restrict)
  analysisResults AnalysisResult[]

  @@unique([organizationId, id])
  @@unique([organizationId, sourceId, externalId])
  @@index([organizationId, status, severity])
  @@index([organizationId, sourceId])
  @@map("alerts")
}

model MonitoringWebhookCredential {
  id             String           @id @default(cuid())
  organizationId String
  sourceId       String
  tokenHash      String           @unique
  createdAt      DateTime         @default(now())
  source         MonitoringSource @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, sourceId])
  @@map("monitoring_webhook_credentials")
}

model AnalysisResult {
  id             String       @id @default(cuid())
  organizationId String
  alertId        String?
  summary        String
  details        Json?
  model          String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alert          Alert?       @relation(fields: [organizationId, alertId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, alertId])
  @@map("analysis_results")
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String
  stripeSubscriptionId String             @unique
  plan                 SubscriptionPlan
  status               SubscriptionStatus
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  lastEventCreatedAt   BigInt?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("subscriptions")
}

model ProcessedStripeEvent {
  id          String   @id
  eventType   String
  processedAt DateTime @default(now())

  @@map("processed_stripe_events")
}
